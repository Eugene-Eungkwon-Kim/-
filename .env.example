# AVM Agent 환경변수 설정

# ─── 데이터베이스 ────────────────────────────────
# SQLite (개발용, 기본값)
DATABASE_URL=sqlite:///D:/NPL전례/avm_project/data/npl_avm.db

# PostgreSQL (운영용, Phase 이관 후)
# DATABASE_URL=postgresql://user:password@localhost:5432/avm_db

# ─── 국토부 실거래가 공공 API ────────────────────
# 신청: https://www.data.go.kr/
# 검색: "아파트매매 실거래자료 조회"
KOREA_API_KEY=YOUR_API_KEY_HERE

# ─── Anthropic (Claude API) ──────────────────────
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# ─── Kakao Map API (주소-좌표 변환용) ───────────
# 신청: https://developers.kakao.com/
KAKAO_REST_API_KEY=YOUR_KAKAO_KEY_HERE

# ─── 서버 설정 ──────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO
