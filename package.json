{
  "name": "maars-web",
  "version": "0.2.0",
  "description": "MAARS 부동산 플랫폼 - Phase 2 금융로직 테스트",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "vite-node src/server/index.ts",
    "dev:all": "concurrently -n server,web -c blue,green \"npm:server\" \"npm:dev\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:debug": "vitest --inspect-brk --inspect --single-thread",
    "test:d09": "vitest run src/services/loan-service.spec.ts src/services/interest-calculator.spec.ts src/services/credit-assessment.spec.ts src/services/document-validator.spec.ts --coverage",
    "test:ci": "vitest run --coverage --reporter=junit --outputFile=test-results.xml",
    "lint": "biome lint .",
    "format": "biome format .",
    "type-check": "tsc --noEmit",
    "db:migrate": "vite-node src/db/migrate-cli.ts up",
    "db:migrate:status": "vite-node src/db/migrate-cli.ts status",
    "db:migrate:rollback": "vite-node src/db/migrate-cli.ts down",
    "db:migrate:dry-run": "vite-node src/db/migrate-cli.ts dry-run"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^0.34.0",
    "@vitest/ui": "^0.34.0",
    "concurrently": "^10.0.3",
    "happy-dom": "^12.0.0",
    "msw": "^1.3.0",
    "typescript": "^5.0.0",
    "vite": "^4.5.0",
    "vite-node": "^0.34.0",
    "vitest": "^0.34.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.9.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
