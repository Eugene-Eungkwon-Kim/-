{
  "name": "maars-web",
  "version": "0.2.0",
  "description": "MAARS 부동산 플랫폼 - Phase 2 금융로직 테스트",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:debug": "vitest --inspect-brk --inspect --single-thread",
    "test:d09": "vitest run src/services/loan-service.spec.ts src/services/interest-calculator.spec.ts src/services/credit-assessment.spec.ts --coverage",
    "test:ci": "vitest run --coverage --reporter=junit --outputFile=test-results.xml",
    "lint": "biome lint .",
    "format": "biome format .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^0.34.0",
    "@vitest/ui": "^0.34.0",
    "happy-dom": "^12.0.0",
    "msw": "^1.3.0",
    "typescript": "^5.0.0",
    "vite": "^4.5.0",
    "vitest": "^0.34.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
