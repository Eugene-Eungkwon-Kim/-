{
  "schedule": {
    "type": "weekly",
    "day_of_week": "thursday",
    "hour": 10,
    "minute": 0,
    "timezone": "Asia/Seoul",
    "description": "매주 목요일 10:00에 재학습 시작"
  },
  "data_path": "data/raw/real_estate_2024.csv",
  "model_dir": "models",
  "log_file": "logs/retrain_history.jsonl",
  "test_size": 0.15,
  "val_size": 0.15,
  "performance_threshold": 0.95,
  "rmse_threshold": 60000000,
  "alert_config": {
    "enable_email": false,
    "enable_slack": false,
    "email_address": null,
    "slack_webhook": null,
    "alert_on_degradation": true,
    "alert_on_failure": true
  },
  "model_config": {
    "random_forest": {
      "n_estimators": 300,
      "max_depth": 20,
      "min_samples_split": 5,
      "min_samples_leaf": 2,
      "random_state": 42,
      "n_jobs": -1
    },
    "gradient_boosting": {
      "n_estimators": 300,
      "max_depth": 5,
      "learning_rate": 0.1,
      "min_samples_split": 5,
      "min_samples_leaf": 2,
      "random_state": 42
    },
    "xgboost": {
      "n_estimators": 300,
      "max_depth": 6,
      "learning_rate": 0.1,
      "random_state": 42,
      "n_jobs": -1
    },
    "lightgbm": {
      "n_estimators": 300,
      "max_depth": 6,
      "learning_rate": 0.1,
      "random_state": 42,
      "n_jobs": -1
    }
  },
  "ensemble_config": {
    "type": "stacking",
    "meta_learner": "xgboost",
    "meta_learner_params": {
      "n_estimators": 200,
      "max_depth": 5,
      "learning_rate": 0.05,
      "random_state": 42,
      "n_jobs": -1
    }
  },
  "cron_config": {
    "linux_mac": "0 10 * * 4 cd /home/user/-/avm_project && /usr/bin/python3 scripts/weekly_retrain_scheduler.py >> logs/weekly_retrain.cron.log 2>&1",
    "windows": "At 10:00 on Thursday - python.exe C:\\path\\to\\avm_project\\scripts\\weekly_retrain_scheduler.py",
    "note": "Linux/Mac: crontab -e에 위 명령 추가 | Windows: Task Scheduler에 등록"
  },
  "monitoring": {
    "enabled": true,
    "check_interval_hours": 24,
    "history_retention_days": 365,
    "trend_calculation_window": 10
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(levelname)s - %(message)s",
    "files": {
      "retrain_log": "logs/weekly_retrain.log",
      "monitor_log": "logs/performance_monitor.log",
      "history_log": "logs/retrain_history.jsonl"
    }
  },
  "feature_columns": [
    "거래금액",
    "거래일",
    "면적",
    "지역",
    "건축년도",
    "층수",
    "방_개수",
    "욕실_개수",
    "엘리베이터",
    "주차장",
    "위도",
    "경도",
    "nearby_gas_stations",
    "avg_gas_price",
    "min_gas_price",
    "max_gas_price",
    "gas_station_density"
  ]
}
