{
  "metrics": {
    "predictions_total": {
      "type": "Counter",
      "help": "Total predictions",
      "labels": [
        "region",
        "status"
      ]
    },
    "predict_duration_seconds": {
      "type": "Histogram",
      "help": "Prediction request duration",
      "buckets": [
        0.01,
        0.05,
        0.1,
        0.5,
        1.0
      ]
    },
    "cache_hit_ratio": {
      "type": "Gauge",
      "help": "Cache hit ratio",
      "labels": [
        "region"
      ]
    },
    "model_r2_score": {
      "type": "Gauge",
      "help": "Current model R\u00b2 score"
    },
    "api_uptime_percent": {
      "type": "Gauge",
      "help": "API uptime percentage"
    },
    "data_collection_duration_seconds": {
      "type": "Histogram",
      "help": "Data collection duration"
    },
    "model_retrain_duration_seconds": {
      "type": "Histogram",
      "help": "Model retraining duration"
    }
  }
}