{
  "opinet": {
    "api_key": "F260619859",
    "api_version": "1.0",
    "description": "Korean Gas Station Price Information via Opinet API",
    "provider": "한국석유공사 오피넷(Opinet)"
  },
  "gas_station_search": {
    "service": "aroundAll",
    "request": "getGasStations",
    "format": "json",
    "timeout": 10,
    "radius_options": [1000, 2000, 5000],
    "default_radius": 2000
  },
  "price_retrieval": {
    "service": "avgSido",
    "request": "getPriceByRegion",
    "format": "json",
    "timeout": 10
  },
  "rate_limiting": {
    "delay_seconds": 0.5,
    "max_concurrent_requests": 1,
    "description": "API 요청 제한 (초당 2개)"
  },
  "data_enrichment": {
    "output_columns": [
      "nearby_gas_stations",
      "avg_gas_price",
      "min_gas_price",
      "max_gas_price",
      "gas_station_density"
    ],
    "search_radius_meters": 2000,
    "fuel_types": ["휘발유", "경유", "LPG"],
    "default_fuel_type": "휘발유"
  },
  "error_handling": {
    "log_failed_queries": true,
    "skip_invalid_coordinates": true,
    "null_on_error": true
  },
  "output": {
    "format": "csv",
    "encoding": "utf-8",
    "save_metadata": true,
    "output_path": "avm_project/data/raw/real_estate_2024_opinet_enriched.csv"
  },
  "performance": {
    "batch_size": 100,
    "parallel_processing": false,
    "cache_results": true,
    "cache_path": "avm_project/.opinet_cache"
  },
  "statistics": {
    "calculate_density": true,
    "density_radius_km": 2.0,
    "include_price_variance": true
  }
}
