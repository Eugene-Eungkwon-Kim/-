{
  "project": {
    "name": "Automated Valuation Model (AVM) Development",
    "version": "1.0.0",
    "description": "NPL 데이터 기반 AVM 모델 개발 및 실제 평가 시스템",
    "created_date": "2026-06-09",
    "author": "AI Development Team"
  },
  "data": {
    "source": "D:\\NPL폴더",
    "external_drive": "LG_External_Drive:/AVM_Working/",
    "raw_data_dir": "avm_project/data/raw",
    "processed_data_dir": "avm_project/data/processed"
  },
  "preprocessing": {
    "missing_value_strategy": "mean",
    "outlier_detection_method": "iqr",
    "outlier_threshold": 1.5,
    "normalization_method": "standardize",
    "test_size": 0.2,
    "random_state": 42
  },
  "models": {
    "baseline_models": [
      "linear_regression",
      "decision_tree",
      "random_forest"
    ],
    "advanced_models": [
      "gradient_boosting",
      "xgboost",
      "neural_network"
    ],
    "hyperparameter_tuning": {
      "random_forest": {
        "n_estimators": [50, 100, 150],
        "max_depth": [10, 15, 20],
        "min_samples_split": [2, 5, 10]
      },
      "gradient_boosting": {
        "n_estimators": [50, 100, 150],
        "learning_rate": [0.01, 0.05, 0.1],
        "max_depth": [3, 5, 7]
      }
    }
  },
  "evaluation": {
    "metrics": [
      "rmse",
      "mae",
      "r2_score",
      "mape"
    ],
    "cross_validation_folds": 5,
    "target_r2_score": 0.85,
    "target_rmse": "model_dependent"
  },
  "output": {
    "models_dir": "avm_project/models",
    "results_dir": "avm_project/output",
    "reports_dir": "avm_project/docs"
  },
  "api": {
    "enabled": true,
    "framework": "FastAPI",
    "host": "0.0.0.0",
    "port": 8000,
    "version": "v1"
  },
  "database": {
    "type": "sqlite",
    "path": "avm_project/data/avm.db",
    "backup_enabled": true
  },
  "environment": {
    "python_version": "3.9+",
    "requirements_file": "requirements.txt"
  }
}
