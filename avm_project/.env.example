# AVM Project Configuration
# Environment variables for secure credential management

# API Keys (never commit real values here — this is a template file)
DATAGOVKR_API_KEY=YOUR_DATAGOVKR_API_KEY_HERE
# scripts/fetch_transactions_parallel.py 는 이 이름으로 읽는다(보통 위와 동일 값)
KOREA_API_KEY=YOUR_DATAGOVKR_API_KEY_HERE
DATAGOVKR_DECODING_KEY=YOUR_DATAGOVKR_DECODING_FORMAT_KEY_HERE
VWORLD_API_KEY=YOUR_VWORLD_API_KEY_HERE
OPINET_API_KEY=YOUR_OPINET_API_KEY_HERE
JUSO_API_KEY_PROVIDE=YOUR_JUSO_PROVIDE_KEY_HERE
JUSO_API_KEY_INFO=YOUR_JUSO_INFO_KEY_HERE
JUSO_API_KEY_POPUP=YOUR_JUSO_POPUP_API_KEY_HERE
BOK_API_KEY=YOUR_BANK_OF_KOREA_KEY_HERE
FISIS_API_KEY=YOUR_FISIS_KEY_HERE
MOLIT_STATS_KEY=YOUR_MOLIT_STATS_KEY_HERE
NCP_CLIENT_ID=YOUR_NCP_CLIENT_ID_HERE
NCP_CLIENT_SECRET=YOUR_NCP_CLIENT_SECRET_HERE

# Data Paths
AVM_DATA_PATH=/mnt/avm_data
AVM_MODELS_PATH=./models

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
PREDICTION_TIMEOUT=30

# CORS Settings (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Model Settings
MODEL_R2_THRESHOLD=0.90

# Environment
ENVIRONMENT=development
