{
  "source": {
    "type": "local_filesystem",
    "location": "/home/user/-/avm_project",
    "files": {
      "sample_data": "data/raw/sample_npl_data.csv",
      "processed_data": "data/processed/processed_sample_data.csv",
      "model": "models/production_model.joblib",
      "model_registry": "models/model_registry.json"
    }
  },
  "destination": {
    "type": "cloud_run_with_cloud_sql",
    "project": "your-gcp-project",
    "region": "asia-northeast1",
    "database": {
      "instance": "avm-db",
      "database": "avm_production",
      "user": "avm_user"
    },
    "storage": {
      "bucket": "avm-models-bucket",
      "path": "production/"
    }
  },
  "migration_steps": [
    {
      "step": 1,
      "name": "데이터 검증",
      "command": "python3 scripts/phase3_data_collection.py --validate-only",
      "expected_output": "All data valid"
    },
    {
      "step": 2,
      "name": "모델 검증",
      "command": "python3 -c \"import joblib; m=joblib.load('models/production_model.joblib'); print('Model loaded')\"",
      "expected_output": "Model loaded"
    },
    {
      "step": 3,
      "name": "Cloud SQL 연결",
      "command": "gcloud sql connect avm-db --user=avm_user",
      "expected_output": "Connected"
    },
    {
      "step": 4,
      "name": "데이터 업로드",
      "command": "gsutil -m cp -r data/raw/* gs://avm-models-bucket/data/",
      "expected_output": "Upload complete"
    },
    {
      "step": 5,
      "name": "모델 배포",
      "command": "gsutil cp models/production_model.joblib gs://avm-models-bucket/models/",
      "expected_output": "Deployment complete"
    }
  ],
  "rollback_plan": {
    "backup_location": "backups",
    "recovery_command": "gsutil -m cp -r gs://avm-backup-bucket/* .",
    "validation_script": "scripts/test_system.py"
  },
  "timestamp": "20260617_101429"
}