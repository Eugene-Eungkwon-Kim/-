# NPL AVM 환경변수 설정 예시
# 복사 후 .env 파일로 사용: cp .env.example .env

# ─── 데이터베이스 ────────────────────────────────
# SQLite (개발용, 기본값)
DATABASE_URL=sqlite:///data/npl_avm.db

# PostgreSQL (운영 이관 시)
# DATABASE_URL=postgresql://user:password@localhost:5432/avm_db

# ─── 국토부 실거래가 공공 API ────────────────────
# 신청: https://www.data.go.kr → "아파트매매 실거래자료 조회"
KOREA_API_KEY=YOUR_API_KEY_HERE

# ─── 서버 설정 ──────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
